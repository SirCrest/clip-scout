{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "titles", "description", "tags", "playlist", "hold", "note"],
    "additionalProperties": false,
    "properties": {
      "id": {"type": "string", "pattern": "^t\\d{6}[a-z]?$"},
      "titles": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {"type": "string", "minLength": 10, "maxLength": 100, "pattern": "^[^<>]*$"}
      },
      "description": {"type": "string", "minLength": 60, "maxLength": 4000, "pattern": "^[^<>]*$"},
      "hashtags": {
        "type": "array",
        "maxItems": 6,
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^#[A-Za-z0-9]{2,40}$"}
      },
      "tags": {
        "type": "array",
        "maxItems": 8,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 2, "maxLength": 40, "pattern": "^[^<>,\"]*$"}
      },
      "playlist": {"type": "string", "minLength": 2, "maxLength": 60},
      "hold": {
        "type": "array",
        "uniqueItems": true,
        "items": {"enum": ["dated", "music", "verify-claim", "profanity", "rights", "other"]}
      },
      "note": {"type": ["string", "null"], "maxLength": 300}
    }
  }
}
