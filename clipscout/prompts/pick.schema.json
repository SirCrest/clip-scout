{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["corrections", "picks"],
  "additionalProperties": false,
  "properties": {
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "why"],
        "additionalProperties": false,
        "properties": {
          "from": {"type": "number"},
          "to": {"type": "number"},
          "why": {"type": "string", "minLength": 3}
        }
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "from", "to"],
        "additionalProperties": false,
        "properties": {
          "t": {"type": "number", "minimum": 0},
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string"}
        }
      }
    },
    "picks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "last", "category", "product", "title", "hook", "summary", "speakers", "score",
                     "flags", "yt_titles", "yt_description"],
        "additionalProperties": false,
        "properties": {
          "start": {"type": "number", "minimum": 0},
          "start_word": {"type": "string", "minLength": 1},
          "last": {"type": "number", "minimum": 0},
          "raw": {"type": "boolean"},
          "category": {"enum": ["chat-qa", "feature", "workflow", "funny", "story"]},
          "product": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 3, "maxLength": 100},
          "hook": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 10},
          "speakers": {"type": "string"},
          "score": {"type": "integer", "minimum": 1, "maximum": 5},
          "flags": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["dated", "music", "gameplay", "guest-creator", "visual", "verify-claim", "profanity",
                               "third-party"]}
          },
          "yt_titles": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "string", "minLength": 3, "maxLength": 100}
          },
          "yt_description": {"type": "string", "minLength": 20, "maxLength": 2000}
        }
      }
    }
  }
}
